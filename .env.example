# Copy to .env (gitignored) next to docker-compose.yml and fill in.
# Every value here is optional — each one missing degrades exactly one thing.

# Proxmox API token, for the container and storage lanes. Read-only is enough:
# the dashboard never writes to Proxmox. Unset means that lane reports itself
# failed and the rest of the panel carries on.
PROXMOX_TOKEN_ID=dashboard@pve!readonly
PROXMOX_TOKEN_SECRET=

# Signs SearXNG's own request tokens. Any long random string:
#   openssl rand -hex 32
SEARXNG_SECRET=
